//find a way to handle the printing through a method instead of repeating code.
import java.util.Scanner;

public class MyStudentGradeAndAcidemicStandingSystem {
    public static void main(String args[]) {
        Scanner input = new Scanner(System.in);
        System.out.print("Enter your student ID: ");
        int studentID = input.nextInt();
        System.out.println("***************************************");
        
        //Each value will have 3 arrays a string array for the class names, an int array for numerical grades, and a cha array for letter grades
        // No grades lower than 42
        String [] names0 = {"ART101","BIOL101","CSCI101","GEOG101","HIST"};
        int [] grades0 = {79, 90, 56, 92, 62};
        char[] letters0 = {'A','A','A','A','A'};
        
        //The system for outputing the results
        if(studentID % 17 == 0){
            for(int i = 0; i < names0.length; i++){
                System.out.print(names0[i] + "\t");
            }
            System.out.println("");
            for(int i = 0; i < grades0.length; i++){
                System.out.print(grades0[i] + "\t\t");
                if (grades0[i] < 60){
                    letters0[i] = 'F';
                } else if (grades0[i] < 70){
                    letters0[i] = 'D';
                } else if (grades0[i] < 80){
                    letters0[i] = 'C';
                } else if (grades0[i] < 90){
                    letters0[i] = 'B';
                } else {
                    letters0[i] = 'A';
                }
            }
            System.out.println("");
            for(int i = 0; i < names0.length; i++){
                System.out.print(letters0[i] + "\t\t");
            }
        }
    }
}
