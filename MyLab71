import java.io.*;
import java.util.Scanner;
 
public class MyLab71{
    public static void main(String[] args) throws Exception {
 
        Scanner keyboard = new Scanner(System.in);
        PrintWriter output = new PrintWriter("employees.txt");
        
        int employeeNum = 0;
        int ID = 0;
        String name = "a";
        String department = "b";
        
        System.out.print("How many Employees? ");
        employeeNum = keyboard.nextInt();
        
        for(int i = 0; i < employeeNum; i++){
            int ittt = i + 1;
            System.out.println("Employee " + ittt);
            System.out.print("ID: ");
            ID = keyboard.nextInt();
            System.out.print("Name: ");
            name = keyboard.next();
            System.out.print("Department: ");
            department = keyboard.next();
            System.out.println(" ");
            output.println(ID + "," + name + "," + department);
        }
        
        output.close();
        keyboard.close();
 
        System.out.println("Employee database created.");
    }
}
