import java.util.Scanner;
public class MyLab64 {
  public static void main(String args[]) {
    boolean length = false;
    boolean upper = false;
    boolean lower = false;
    boolean digit = false;
    boolean valid = false;
    String password ="a";
    Scanner input = new Scanner(System.in);
    
    System.out.print("Enter a password: ");
    password = input.next();
    
    for(int i = 0; i < password.length(); i++){
        char ch = password.charAt(i);
        if (Character.isUpperCase(ch) == true){
            upper = true;
        }
        if (Character.isLowerCase(ch) == true){
            lower = true;
        }
        if (Character.isDigit(ch) == true){
            digit = true;
        }
    }
   if (password.length() >= 8){
       length = true;
   }
   
   System.out.println("\nPassword Validation Results");
   if(length == true){
       System.out.println("Length Requirements meet");
   } else {
       System.out.println("Length Requirements not meet");
   }
   if(upper == true){
       System.out.println("Contains Uppercase Letter");
   } else {
       System.out.println("Does Not Contain UpperCase Letter");
   }
   if(lower == true){
       System.out.println("Contains Lowercase Letter");
   } else {
       System.out.println("Does Not Contain LowerCase Letter");
   }
   if(digit == true){
       System.out.println("Contains Number");
   } else {
       System.out.println("Does Not Contain Number");
   }
   System.out.println("");
   if(length == true && upper == true && lower == true && digit == true){
       System.out.println("Password is VALID");
   } else {
       System.out.println("Password is not VALID");
   }
   
  }
}
